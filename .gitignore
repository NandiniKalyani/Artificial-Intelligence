# ---------------------------------------------------------------------------
# Secrets. Nothing below this line should ever exist in a commit.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
credentials.json
service-account*.json
secrets.yaml
secrets.yml
*_rsa
*_ed25519
.aws/
.azure/
kubeconfig
*.kubeconfig

# ---------------------------------------------------------------------------
# Models and data. Far too big for git, and the corpus is not mine to publish.
# ---------------------------------------------------------------------------
models/
data/
corpus/

# the localai model dir is the exception. The yaml is config and belongs in git,
# the gguf it downloads next to it does not. The directory has to be un-ignored
# first, git will not look inside an excluded one
!deploy/localai/models/
deploy/localai/models/*
!deploy/localai/models/*.yaml

*.gguf
*.safetensors
*.bin
qdrant_storage/

# model weights land next to their config when localai downloads them
deploy/localai/models/*.gguf

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
.venv/
venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
