# Copy to .env and adjust. .env is gitignored, this file is not.
# Nothing in here is a secret, the whole stack runs locally with no accounts.

QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

LOCALAI_PORT=8081
# match this to your physical cores, not threads. 4 is a safe starting point
LOCALAI_THREADS=4

EMBEDDINGS_PORT=8082

LOG_LEVEL=info
