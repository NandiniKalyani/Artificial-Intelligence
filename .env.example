# Copy to .env and adjust. .env is gitignored, this file is not.
# Nothing in here is a secret, the whole stack runs locally with no accounts.

QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

LOCALAI_PORT=8081
# match this to your physical cores, not threads. 4 is a safe starting point
LOCALAI_THREADS=4

EMBEDDINGS_PORT=8082
# changing the model almost certainly changes the dimensions, and every vector
# already in qdrant becomes meaningless. Recreate the collection after this
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_TEXTS=256

QDRANT_COLLECTION=docs
VECTOR_SIZE=384

LLM_MAX_TOKENS=300
LLM_TEMPERATURE=0.2

LOG_LEVEL=info
